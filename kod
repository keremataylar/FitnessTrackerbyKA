        {/* DASHBOARD & FORECAST TAB */}
        {activeTab === 'dashboard' && (
          stats ? (
            <div className="space-y-6">
              
              {/* DISCIPLINE STREAK & TOP BANNER */}
              <div className="bg-gradient-to-r from-slate-900 via-slate-900 to-emerald-950/40 border border-emerald-500/30 p-4 sm:p-5 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
                <div className="flex items-center gap-3">
                  <div className="p-3 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20 flex items-center justify-center">
                    <Zap className="w-6 h-6 animate-pulse" />
                  </div>
                  <div>
                    <div className="flex items-center gap-2">
                      <span className="text-xs font-bold text-amber-400 uppercase tracking-wider">Disiplin Serisi</span>
                      <span className="bg-amber-500/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full font-bold">
                        {stats.streak} GÜN KESİNTİSİZ
                      </span>
                    </div>
                    <h2 className="text-base font-bold text-white mt-0.5">
                      {stats.streak >= 7 ? 'Harika bir serin var! İstikrar sonuç getirir.' : 'Düzenli veri girişi yaparak trendini netleştir.'}
                    </h2>
                  </div>
                </div>

                <div className="flex items-center gap-4 text-xs bg-slate-950/80 px-4 py-2 rounded-xl border border-slate-800">
                  <div>
                    <span className="text-slate-400 block">Dinamik BMR (Mifflin)</span>
                    <span className="font-bold text-emerald-400">{stats.latestLog.bmr} kcal/gün</span>
                  </div>
                  <div className="h-6 w-px bg-slate-800" />
                  <div>
                    <span className="text-slate-400 block">Kilo Başı Protein</span>
                    <span className="font-bold text-teal-300">{stats.proteinPerKg} g/kg</span>
                  </div>
                </div>
              </div>

              {/* KPI CARDS GRID */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                
                {/* Weight Card */}
                <div className="bg-slate-900 border border-slate-800 p-4 rounded-2xl flex items-center justify-between">
                  <div>
