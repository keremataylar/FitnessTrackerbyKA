      setLogs(prev => prev.filter(item => item.id !== id));
      showToast('Kayıt silindi.');
    }
  };

  // Clear all data
  const handleClearAllData = () => {
    setLogs([]);
    localStorage.removeItem('fit_app_logs');
    setShowClearConfirmModal(false);
    showToast('Tüm veriler tamamen sıfırlandı.');
  };

  // Advanced Stats & 7-Day Moving Average Computations
  const stats = useMemo(() => {
    if (sortedLogs.length === 0) return null;

    const processed = sortedLogs.map((log, index, arr) => {
      const totalBurned = (log.bmr || 0) + (log.exercise || 0);
      const deficit = (log.intake || 0) - totalBurned;

      // Calculate 7-Day Moving Average for weight
      const sliceStart = Math.max(0, index - 6);
      const windowLogs = arr.slice(sliceStart, index + 1);
      const avgWeight = windowLogs.reduce((acc, curr) => acc + curr.weight, 0) / windowLogs.length;

      // Calculate US Navy Body Fat %
      const bodyFat = calculateBodyFat(profile.gender, log.waist, log.neck, profile.height, log.hip);

      return {
        ...log,
        totalBurned,
        deficit,
        movingAvgWeight: parseFloat(avgWeight.toFixed(2)),
        bodyFat
      };
    });

    const recentLogs = processed.slice(-forecastDays);
    const avgDailyDeficit = recentLogs.reduce((acc, curr) => acc + curr.deficit, 0) / (recentLogs.length || 1);
    const avgProtein = recentLogs.reduce((acc, curr) => acc + (curr.protein || 0), 0) / (recentLogs.length || 1);
    const avgWater = recentLogs.reduce((acc, curr) => acc + (curr.water || 0), 0) / (recentLogs.length || 1);
    
    const latestLog = processed[processed.length - 1];
    const initialLog = processed[0];

    const totalWeightChange = (latestLog.weight - initialLog.weight).toFixed(1);
    const proteinPerKg = (avgProtein / (latestLog.weight || 1)).toFixed(2);

    // Calculate Streak (Consecutive days logged up to latest)
    let streak = 0;
    if (processed.length > 0) {
      streak = 1;
      for (let i = processed.length - 1; i > 0; i--) {
        const currDate = new Date(processed[i].date);
        const prevDate = new Date(processed[i-1].date);
        const diffDays = Math.round((currDate - prevDate) / (1000 * 60 * 60 * 24));
        if (diffDays === 1) {
          streak++;
        } else {
          break;
        }
      }
    }

    return {
      processedLogs: processed,
      avgDailyDeficit,
      avgProtein,
      avgWater,
      latestLog,
      initialLog,
      totalWeightChange,
      proteinPerKg,
      streak
    };
  }, [sortedLogs, forecastDays, profile]);

  // Future Projection Calculator
  const forecast = useMemo(() => {
    if (!stats || stats.processedLogs.length === 0) return [];

    const { avgDailyDeficit, avgProtein, latestLog } = stats;
    const latestWeight = latestLog.weight;
    const proteinPerKg = avgProtein / latestWeight;
    const fatLossRatio = proteinPerKg >= 1.8 ? 0.88 : 0.72;

    const generateProjection = (days) => {
      const totalDeficitKcal = avgDailyDeficit * days;
      const totalWeightDiffKg = totalDeficitKcal / 7700;
      
      let fatLossKg = 0;
      let muscleChangeKg = 0;

      if (totalWeightDiffKg < 0) {
        fatLossKg = Math.abs(totalWeightDiffKg) * fatLossRatio;
        muscleChangeKg = -(Math.abs(totalWeightDiffKg) - fatLossKg);
      } else {
        fatLossKg = totalWeightDiffKg * 0.3;
        muscleChangeKg = totalWeightDiffKg * 0.7;
      }

      const predictedWeight = Math.max(35, latestWeight + totalWeightDiffKg);
      const lastDate = new Date(latestLog.date);
      lastDate.setDate(lastDate.getDate() + days);

      return {
        days,
        targetDateStr: lastDate.toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' }),
        predictedWeight: predictedWeight.toFixed(2),
        weightDiff: (totalWeightDiffKg >= 0 ? `+${totalWeightDiffKg.toFixed(2)}` : totalWeightDiffKg.toFixed(2)),
        fatLoss: fatLossKg.toFixed(2),
        muscleChange: (muscleChangeKg >= 0 ? `+${muscleChangeKg.toFixed(2)}` : muscleChangeKg.toFixed(2))
      };
    };

    return [generateProjection(7), generateProjection(14), generateProjection(30)];
  }, [stats]);

  // Combined Chart Data (History + Future Forecast)
  const chartData = useMemo(() => {
    if (!stats) return [];

    const historic = stats.processedLogs.map(item => ({
      date: new Date(item.date).toLocaleDateString('tr-TR', { month: 'short', day: 'numeric' }),
      ApsisDate: item.date,
      Kilo: item.weight,
      HareketliOrt: item.movingAvgWeight,
      TahminiKilo: null,
      Alınan: item.intake,
      Harcanan: item.totalBurned,
      Deficit: item.deficit,
      Protein: item.protein,
      Yag: item.fat,
      Karb: item.carbs,
      BodyFat: item.bodyFat
    }));

    if (historic.length === 0) return [];

    const lastEntry = historic[historic.length - 1];
    const lastDate = new Date(lastEntry.ApsisDate);
    const lastWeight = lastEntry.Kilo;
    const avgDeficit = stats.avgDailyDeficit;
    const dailyWeightChange = avgDeficit / 7700;

    const projectedPoints = [1, 3, 7, 14, 21, 30].map(daysAhead => {
      const d = new Date(lastDate);
      d.setDate(d.getDate() + daysAhead);
      const projWeight = (lastWeight + dailyWeightChange * daysAhead).toFixed(2);
      return {
        date: d.toLocaleDateString('tr-TR', { month: 'short', day: 'numeric' }),
        ApsisDate: d.toISOString().split('T')[0],
        Kilo: null,
        HareketliOrt: null,
        TahminiKilo: parseFloat(projWeight),
        Alınan: null,
        Harcanan: null,
        Deficit: Math.round(avgDeficit),
        Protein: null,
        Yag: null,
        Karb: null,
        BodyFat: null
      };
    });

    const mergedLast = { ...lastEntry, TahminiKilo: lastEntry.Kilo };
    return [...historic.slice(0, -1), mergedLast, ...projectedPoints];
  }, [stats]);

  // Export Data JSON
  const handleExportData = () => {
    const payload = { profile, logs };
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(payload, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `fit_track_backup_${new Date().toISOString().split('T')[0]}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
    showToast('Tüm verileriniz JSON dosyası olarak indirildi.');
  };

  // Import Data JSON
  const handleImportData = (e) => {
    const fileReader = new FileReader();
    if (e.target.files && e.target.files[0]) {
      fileReader.readAsText(e.target.files[0], "UTF-8");
      fileReader.onload = (event) => {
        try {
          const parsed = JSON.parse(event.target.result);
          if (parsed.logs && Array.isArray(parsed.logs)) {
            setLogs(parsed.logs);
            if (parsed.profile) setProfile(parsed.profile);
            showToast('Veriler başarıyla yükledi!');
          } else if (Array.isArray(parsed)) {
            setLogs(parsed);
            showToast('Kayıtlar başarıyla yüklendi!');
          } else {
            showToast('Geçersiz yedek dosyası.');
          }
        } catch (error) {
          showToast('Dosya okunurken bir hata oluştu.');
        }
      };
    }
  };

  const filteredLogs = useMemo(() => {
    return sortedLogs.filter(l => 
      l.date.includes(searchTerm) || 
      (l.note && l.note.toLowerCase().includes(searchTerm.toLowerCase()))
    ).reverse();
  }, [sortedLogs, searchTerm]);

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans selection:bg-emerald-500 selection:text-slate-950">
      
      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed top-5 right-5 z-50 bg-emerald-500 text-slate-950 font-bold px-4 py-2.5 rounded-xl shadow-2xl flex items-center gap-2 animate-bounce border border-emerald-400">
          <CheckCircle2 className="w-5 h-5" />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* CLEAR CONFIRMATION MODAL */}
      {showClearConfirmModal && (
        <div className="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 p-6 rounded-2xl max-w-md w-full space-y-4 shadow-2xl">
            <div className="flex items-center gap-3 text-rose-400">
              <div className="p-2 bg-rose-500/10 rounded-xl">
                <AlertTriangle className="w-6 h-6" />
              </div>
              <h3 className="text-lg font-bold text-white">Tüm Verileri Sıfırla?</h3>
            </div>
            <p className="text-xs text-slate-400 leading-relaxed">
              Bu işlem tüm kalori, kilo, vücut ölçüsü, su ve not kayıtlarınızı siler. Sıfırdan temiz bir sayfa açılacaktır.
            </p>
            <div className="flex items-center justify-end gap-3 pt-2">
              <button
                onClick={() => setShowClearConfirmModal(false)}
                className="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 hover:bg-slate-700"
              >
                İptal
              </button>
              <button
                onClick={handleClearAllData}
                className="px-4 py-2 rounded-xl text-xs font-semibold bg-rose-600 text-white hover:bg-rose-500 shadow-lg shadow-rose-600/30"
              >
                Evet, Hepsini Sil
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Header Bar */}
      <header className="bg-slate-900/90 border-b border-slate-800 sticky top-0 z-40 backdrop-blur">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <div className="flex items-center gap-3">
