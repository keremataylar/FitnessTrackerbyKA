<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kalori ve Makro Takip Asistanı</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen p-4 font-sans">
  <div class="max-w-4xl mx-auto space-y-6">
    <header class="flex justify-between items-center bg-slate-800 p-4 rounded-xl border border-slate-700">
      <div>
        <h1 class="text-2xl font-bold text-blue-400"><i class="fa-solid fa-heart-pulse mr-2"></i>Kalori & Makro Takip</h1>
        <p class="text-xs text-slate-400">Dinamik BMR, Su ve Trend Analiz Asistanı</p>
      </div>
      <button onclick="clearAllData()" class="bg-red-600/30 hover:bg-red-600 text-red-200 px-3 py-1.5 rounded-lg text-sm transition">
        <i class="fa-solid fa-trash mr-1"></i>Sıfırla
      </button>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Profil & BMR -->
      <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-3">
        <h3 class="font-semibold text-slate-300"><i class="fa-solid fa-user mr-2"></i>Fiziksel Profil</h3>
        <div class="space-y-2 text-sm">
          <div>Cinsiyet: 
            <select id="gender" onchange="updateProfile()" class="bg-slate-700 px-2 py-1 rounded w-full mt-1 text-white">
              <option value="male">Erkek</option>
              <option value="female">Kadın</option>
            </select>
          </div>
          <div>Yaş: <input type="number" id="age" value="28" onchange="updateProfile()" class="bg-slate-700 px-2 py-1 rounded w-full mt-1 text-white"/></div>
          <div>Boy (cm): <input type="number" id="height" value="178" onchange="updateProfile()" class="bg-slate-700 px-2 py-1 rounded w-full mt-1 text-white"/></div>
          <div class="pt-2 text-blue-400 font-semibold text-base" id="bmrDisplay">Hesaplanan BMR: 1800 kcal</div>
        </div>
      </div>

      <!-- Veri Girişi Formu -->
      <form onsubmit="saveLog(event)" class="md:col-span-2 bg-slate-800 p-4 rounded-xl border border-slate-700 space-y-3">
        <h3 class="font-semibold text-slate-300"><i class="fa-solid fa-pen-to-square mr-2"></i>Günlük Veri Girişi</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
          <div><label class="text-xs text-slate-400">Tarih</label><input type="date" id="logDate" class="bg-slate-700 p-2 rounded w-full text-white" required></div>
          <div><label class="text-xs text-slate-400">Kilo (kg)</label><input type="number" step="0.1" id="logWeight" placeholder="80" class="bg-slate-700 p-2 rounded w-full text-white"></div>
          <div><label class="text-xs text-slate-400">Alınan Kalori</label><input type="number" id="logIntake" placeholder="2200" class="bg-slate-700 p-2 rounded w-full text-white"></div>
          <div><label class="text-xs text-slate-400">Egzersiz (kcal)</label><input type="number" id="logExercise" placeholder="500" class="bg-slate-700 p-2 rounded w-full text-white"></div>
          <div><label class="text-xs text-slate-400">Protein (g)</label><input
