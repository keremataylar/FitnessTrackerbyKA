// Calculate Dynamic BMR using Mifflin-St Jeor
const calculateBMR = (weight, height, age, gender) => {
  if (!weight || !height || !age) return 1900;
  let bmr = (10 * weight) + (6.25 * height) - (5 * age);
  bmr += gender === 'male' ? 5 : -161;
  return Math.round(bmr);
};

// Calculate Body Fat Percentage using US Navy Formula
const calculateBodyFat = (gender, waist, neck, height, hip) => {
  if (!waist || !neck || !height) return null;
  try {
    if (gender === 'male') {
      if (waist <= neck) return null;
      const bf = 495 / (1.0324 - 0.19077 * Math.log10(waist - neck) + 0.15456 * Math.log10(height)) - 450;
      return Math.max(3, Math.min(50, parseFloat(bf.toFixed(1))));
    } else {
      if (!hip || (waist + hip) <= neck) return null;
      const bf = 495 / (1.29579 - 0.35004 * Math.log10(waist + hip - neck) + 0.22100 * Math.log10(height)) - 450;
      return Math.max(8, Math.min(55, parseFloat(bf.toFixed(1))));
    }
  } catch (e) {
    return null;
  }
};

export default function App() {
  // Local storage profile state
  const [profile, setProfile] = useState(() => {
    const saved = localStorage.getItem('fit_app_profile');
    return saved ? JSON.parse(saved) : DEFAULT_PROFILE;
  });

  // Local storage logs state
  const [logs, setLogs] = useState(() => {
    const saved = localStorage.getItem('fit_app_logs');
    if (saved) {
      try { return JSON.parse(saved); } catch (e) { return INITIAL_DATA; }
    }
