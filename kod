    }));
  };

  // Date selection in form (Auto-fill if entry exists)
  const handleDateChange = (e) => {
    const selectedDate = e.target.value;
    const existingLog = logs.find(l => l.date === selectedDate);
    
    if (existingLog) {
      setFormData(existingLog);
      setEditingId(existingLog.id);
      showToast(`${selectedDate} tarihli kayıt bulundu ve yüklendi.`);
    } else {
      setEditingId(null);
      const latestWeight = sortedLogs.length > 0 ? sortedLogs[sortedLogs.length - 1].weight : 80;
      const computedBMR = calculateBMR(latestWeight, profile.height, profile.age, profile.gender);
      setFormData(prev => ({
        ...prev,
        date: selectedDate,
        bmr: computedBMR,
        note: ''
      }));
    }
  };

  // Water Quick Add Helper
  const addWater = (amount) => {
    setFormData(prev => ({
      ...prev,
      water: Math.max(0, (prev.water || 0) + amount)
    }));
  };

  // Submit Log Entry
  const handleSubmitLog = (e) => {
    e.preventDefault();
    if (!formData.date) {
      showToast('Lütfen bir tarih seçin.');
      return;
    }

    const payload = {
      ...formData,
      bmr: formData.bmr || calculateBMR(formData.weight, profile.height, profile.age, profile.gender)
    };

    if (editingId) {
      setLogs(prev => prev.map(item => item.id === editingId ? { ...payload, id: editingId } : item));
      showToast(`${payload.date} tarihli kayıt başarıyla güncellendi.`);
      setEditingId(null);
    } else {
      const existsIndex = logs.findIndex(l => l.date === payload.date);
      if (existsIndex > -1) {
        const updated = [...logs];
        updated[existsIndex] = { ...payload, id: logs[existsIndex].id };
        setLogs(updated);
        showToast(`${payload.date} tarihli kayıt güncellendi!`);
      } else {
        const newEntry = { ...payload, id: Date.now().toString() };
        setLogs(prev => [...prev, newEntry].sort((a, b) => new Date(a.date) - new Date(b.date)));
        showToast(`${payload.date} tarihi için yeni kayıt eklendi!`);
      }
